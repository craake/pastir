#!/usr/bin/env bash
# subagent <planner|implementer|reviewer> [--note "extra instructions"]
#
# Runs one subagent with the model mapped to its role in roles.conf, captures its output in
# $LOOP_RUN_DIR, and prints the result for the orchestrator. If herdr-core (`hc`) is reachable,
# the subagent runs in its own Herdr terminal so you can watch / attach to it.
set -euo pipefail

# Default to the install this executable lives in (resolves the ~/.local/bin symlink), so a custom
# install dir works from fresh shells and the PowerShell launcher without LOOP_HOME being set.
LOOP_HOME="${LOOP_HOME:-$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")}"
# shellcheck source=/dev/null
source "$LOOP_HOME/config/roles.conf"

die() { echo "subagent: $*" >&2; exit 2; }

role="${1:-}"; shift || true
note=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --note) note="${2:-}"; shift 2 ;;
    *) die "unknown argument: $1" ;;
  esac
done

case "$role" in
  planner)     cli="$PLANNER_CLI";     model="$PLANNER_MODEL";     flags="$PLANNER_FLAGS" ;;
  implementer) cli="$IMPLEMENTER_CLI"; model="$IMPLEMENTER_MODEL"; flags="$IMPLEMENTER_FLAGS" ;;
  reviewer)    cli="$REVIEWER_CLI";    model="$REVIEWER_MODEL";    flags="$REVIEWER_FLAGS" ;;
  *) die "usage: subagent <planner|implementer|reviewer> [--note \"...\"]" ;;
esac

[[ -n "${LOOP_RUN_DIR:-}" && -d "$LOOP_RUN_DIR" ]] || die "LOOP_RUN_DIR not set — start runs with 'pastir'"
command -v "$cli" >/dev/null || die "'$cli' not found on PATH (needed for role $role)"
RUN="$LOOP_RUN_DIR"
# Keys added after the first release: older installs keep their old roles.conf, so default them here.
lean="${LEAN_CLAUDE:-yes}"
preview="${OUTPUT_PREVIEW_LINES:-80}"
# Only a plain non-negative integer is valid (a negative value would make head/tail show nearly
# everything, a non-number would abort the report); 10# avoids octal parsing of values like 08.
if [[ $preview =~ ^[0-9]{1,9}$ ]]; then preview=$((10#$preview)); else preview=80; fi
# Enterprise-managed MCP config conflicts with --strict-mcp-config: leave MCP alone when present.
# Only the path for the platform Claude runs on counts (Linux/WSL read /etc/claude-code, never the
# Windows host's copy).
case "$(uname -s)" in
  Darwin) managed_file="/Library/Application Support/ClaudeCode/managed-mcp.json" ;;
  *)      managed_file="/etc/claude-code/managed-mcp.json" ;;
esac
managed_mcp=no
[[ -e $managed_file ]] && managed_mcp=yes

# ── step numbering: 01-planner, 02-implementer, ... ──
n=$(( $(find "$RUN" -maxdepth 1 -name '[0-9][0-9]-*.out.md' | wc -l) + 1 ))
step=$(printf '%02d-%s' "$n" "$role")
prompt="$RUN/$step.prompt.md"
out="$RUN/$step.out.md"
log="$RUN/$step.log"
exitf="$RUN/$step.exit"
runner="$RUN/$step.sh"

# ── assemble the prompt ──
section() { [[ -s "$2" ]] && printf '\n\n---\n# %s\n\n' "$1" && cat "$2"; return 0; }
{
  cat "$LOOP_HOME/prompts/$role.md"
  section "Task" "$RUN/task.md"
  case "$role" in
    implementer)
      section "Plan" "$RUN/plan.md"
      section "Latest code review (fix these findings)" "$RUN/review-latest.md"
      ;;
    reviewer)
      section "Plan" "$RUN/plan.md"
      last_impl=$(ls "$RUN"/[0-9][0-9]-implementer.out.md 2>/dev/null | tail -1 || true)
      if [[ -n "$last_impl" ]]; then section "Implementer's report" "$last_impl"; fi
      # Run from the repo root: from a subdirectory, `.` would limit the patch to that directory while
      # the stat (and the reviewer's view of the change) covers the whole repository.
      root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
      git -C "$root" add -N . >/dev/null 2>&1 || true          # make new files visible to the diff
      base=$(cat "$RUN/base")
      # The stat covers everything, so the reviewer still sees that lockfiles changed; the inline
      # diff leaves out lockfiles and minified assets, which cost many tokens and carry no review signal.
      git -C "$root" diff --stat "$base" > "$RUN/$step.diffstat" || true
      # exclude,glob + **/ so nested lockfiles (monorepo packages) are skipped too, not just root ones.
      git -C "$root" diff "$base" -- . ':(exclude)*.lock' ':(exclude,glob)**/package-lock.json' ':(exclude,glob)**/pnpm-lock.yaml' \
        ':(exclude,glob)**/go.sum' ':(exclude)*.min.js' ':(exclude)*.min.css' > "$RUN/$step.diff" || true
      section "Diff stat (base → working tree)" "$RUN/$step.diffstat"
      if [[ $(wc -c < "$RUN/$step.diff") -gt 400000 ]]; then
        # Point at the saved filtered diff, not a fresh `git diff`, which would bring lockfiles back in.
        printf '\n\n---\n# Diff\n\nDiff is too large to inline (lockfiles and minified assets already omitted). It is saved at %s — read it in sections (e.g. with offset/limit, or per file), not all at once. The diff stat above lists every changed file.\n' "$RUN/$step.diff"
      else
        printf '\n\n---\n# Diff (lockfiles and minified assets omitted; see diff stat)\n\n```diff\n'; cat "$RUN/$step.diff"; printf '\n```\n'
      fi
      ;;
  esac
  if [[ -n "$note" ]]; then printf '\n\n---\n# Orchestrator note\n\n%s\n' "$note"; fi
} > "$prompt"

# ── build the CLI command (prompt always goes in on stdin) ──
q() { printf '%q' "$1"; }
# Absolute path: a Herdr terminal started via hc.exe → wsl.exe is a bare, non-login shell that
# doesn't read ~/.bashrc/~/.profile, so ~/.local/bin, nvm, npm/bun globals are not on its PATH.
bin=$(q "$(command -v "$cli")")
case "$cli" in
  claude)
    # Lean: no MCP servers and no skills/slash commands, whose schemas and listings are re-sent on
    # every request. CLAUDE.md still loads. Placed before $flags so roles.conf flags can override.
    # Only flags the installed CLI lists are added (older versions lack e.g. --disable-slash-commands).
    lean_args=""
    if [[ $lean == yes ]]; then
      help_txt=$("$cli" --help 2>&1 || true)
      if grep -q -- '--disable-slash-commands' <<<"$help_txt"; then lean_args="--disable-slash-commands"; fi
      # The built-in Chrome MCP server is added outside --strict-mcp-config, so turn it off explicitly.
      if grep -q -- '--no-chrome' <<<"$help_txt"; then lean_args="--no-chrome $lean_args"; fi
      if [[ $managed_mcp != yes ]] && grep -q -- '--strict-mcp-config' <<<"$help_txt"; then
        lean_args="--strict-mcp-config $lean_args"
      elif grep -q -- '--disallowedTools' <<<"$help_txt"; then
        # MCP servers can still load here (managed config, or the CLI lacks --strict-mcp-config):
        # deny every MCP tool so none of their schemas are sent. (q: keep the * from globbing.)
        lean_args="--disallowedTools $(q 'mcp__*') $lean_args"
      fi
    fi
    # $flags is spliced in unquoted on purpose: the runner expands it exactly as before.
    cmd="$bin -p --model $(q "$model") $lean_args $flags < $(q "$prompt") 2>>$(q "$log") | tee $(q "$out")" ;;
  codex)  cmd="$bin exec -m $(q "$model") $flags -o $(q "$out") - < $(q "$prompt") 2>&1 | tee -a $(q "$log")" ;;
  omp)    cmd="$bin -p --model $(q "$model") $flags < $(q "$prompt") 2>>$(q "$log") | tee $(q "$out")" ;;
  *) die "unsupported CLI '$cli' for role $role" ;;
esac

# Carry this shell's environment into the runner: PATH (node/bun for the CLIs' shebangs) and any
# API keys / tool config you export in ~/.bashrc. WSL_INTEROP etc. are session-specific: skip them.
envfile="$RUN/env.sh"
if [[ ! -f "$envfile" ]]; then
  export -p | grep -E '^declare -x (PATH|HOME|USER|LANG|LC_[A-Z]+|SHELL|XDG_[A-Z_]+|SSL_CERT_[A-Z_]+|NODE_[A-Z_]+|NVM_[A-Z_]+|BUN_[A-Z_]+|PNPM_HOME|VOLTA_HOME|ANTHROPIC_[A-Z_]+|CLAUDE_CONFIG_DIR|OPENAI_[A-Z_]+|CODEX_HOME|HTTPS?_PROXY|NO_PROXY|https?_proxy|no_proxy)=' > "$envfile" || true
  chmod 600 "$envfile"   # may contain API keys
fi

cat > "$runner" <<EOF
#!/usr/bin/env bash
source $(q "$envfile")
cd $(q "$PWD")
echo "▶ $step  ($cli / $model)"
$cmd
code=\${PIPESTATUS[0]}
echo \$code > $(q "$exitf")
echo "■ $step finished with exit code \$code"
EOF
chmod +x "$runner"

# ── run it: visible Herdr terminal via hc, or inline ──
# Two ways to reach Herdr:
#   hc      — herdr-core running inside WSL/Linux
#   hc.exe  — the Windows Herdr app's herdr-core, called through WSL interop; the new
#             terminal runs wsl.exe back into this distro so the subagent still runs in Linux
use_hc=no; hc_bin=""; launch=(bash "$runner")
if [[ "$USE_HC" != no ]]; then
  if command -v hc >/dev/null && hc ls >/dev/null 2>&1; then
    hc_bin=hc
  elif [[ -n "${WSL_DISTRO_NAME:-}" ]] && command -v hc.exe >/dev/null && hc.exe ls >/dev/null 2>&1; then
    hc_bin=hc.exe
    launch=(wsl.exe -d "$WSL_DISTRO_NAME" --cd "$PWD" -e bash "$runner")
  fi
  [[ -n "$hc_bin" ]] && use_hc=yes
  [[ "$USE_HC" == yes && $use_hc == no ]] && die "USE_HC=yes but neither hc nor hc.exe is reachable"
fi

echo "subagent: $step → $cli/$model$([[ $use_hc == yes ]] && echo " (Herdr terminal via $hc_bin)")" >&2
if [[ $use_hc == yes ]]; then
  run_id=$(basename "$RUN")                # YYYYMMDD-HHMMSS
  name="pastir-${run_id#*-}-$step"         # hc names are max 32 chars: pastir-114905-02-implementer
  "$hc_bin" run --bg --name "$name" "${launch[@]}" >/dev/null
  "$hc_bin" wait "$name" >/dev/null 2>&1 || true
fi
# Inline run, or safety net in case `hc wait` returned early: wait for the exit-code file.
if [[ $use_hc == no ]]; then
  # Not >&2: the orchestrator's Bash tool captures stderr, so the subagent's whole transcript would
  # land in its context (and then again via the preview below). $step.out.md holds the result.
  timeout "$SUBAGENT_TIMEOUT" bash "$runner" > "$RUN/$step.console" 2>&1 || true
else
  for ((i = 0; i < SUBAGENT_TIMEOUT; i += 5)); do [[ -f "$exitf" ]] && break; sleep 5; done
fi

code=$(cat "$exitf" 2>/dev/null || echo 124)
if [[ "$code" == 0 && ! -s "$out" ]]; then code=1; fi   # empty output counts as failure

# ── post-process ──
verdict=""; verdict_note=""
if [[ "$code" == 0 ]]; then
  case "$role" in
    planner)  cp "$out" "$RUN/plan.md" ;;
    reviewer)
      # Only the LAST non-blank line counts, and it must be exactly one of the two verdicts. A
      # "VERDICT: APPROVE" quoted anywhere in the body (e.g. inside a finding) must never approve.
      last=$(grep -v '^[[:space:]]*$' "$out" | tail -n 1 || true)
      last=${last#"${last%%[![:space:]]*}"}; last=${last%"${last##*[![:space:]]}"}
      case "$last" in
        "VERDICT: APPROVE"|"VERDICT: CHANGES_REQUESTED")
          verdict="$last"; cp "$out" "$RUN/review-latest.md" ;;
        *)
          # Malformed review: do NOT publish it. Overwriting review-latest.md would hand the
          # implementer a review that may hold no actionable findings (or lose the previous good one).
          # Fail so the orchestrator retries the reviewer; the raw output stays in $out.
          code=3
          verdict_note="error: reviewer's final line was not a valid verdict (missing/malformed); review-latest.md left unchanged — re-run the reviewer" ;;
      esac
      ;;
  esac
fi

# ── report back to the orchestrator ──
echo "=== $step | $cli/$model | exit $code ==="
echo "full output: $out"
if [[ -s "$log" ]]; then echo "log: $log"; fi
if [[ -s "$RUN/$step.console" ]]; then echo "console: $RUN/$step.console"; fi
echo
if [[ -n "$verdict_note" && -z "$verdict" ]]; then echo "$verdict_note"; exit "$code"; fi
# The verdict is printed once, at the very end — keep it out of the preview and the excerpt below.
if [[ $role == reviewer ]]; then
  head -n "$preview" "$out" 2>/dev/null | grep -Ev '^[[:space:]]*VERDICT:' || true
else
  head -n "$preview" "$out" 2>/dev/null || true
fi
lines=$(grep -c '' "$out" 2>/dev/null || true)   # grep -c '' also counts a final line with no newline
lines=${lines:-0}
if (( lines > preview )); then
  echo "… ($lines lines total — read the full file: $out)"
  # Never let a blocking/major finding, or the "Plan issues" section (it decides whether the
  # orchestrator re-runs the planner), fall past the preview cut.
  if [[ $role == reviewer ]]; then
    awk -v p="$preview" '
      /^[ \t]*VERDICT:/ { next }   # printed once at the end
      /^## /            { sec = ($0 ~ /^## Plan issues/); keep = 0; if (sec && NR > p) hdr = 1 }
      NR > p && sec     { if (!hdr) { print "## Plan issues (cut off above)"; hdr = 1 } print; next }
      # A finding runs from its severity-tagged line to the next tagged line or "## " heading;
      # continuation lines hold the explanation/fix. Only the three real tags start a finding, so a
      # continuation line that begins with a Markdown link ("[docs](…)") does not end it. The tag
      # is judged at the start of the line only: a [minor] finding that quotes "[major]" stays hidden.
      /^[ \t]*([-*][ \t]+)?`?\[(blocking|major|minor)\]/ { keep = ($0 ~ /^[ \t]*([-*][ \t]+)?`?\[(blocking|major)\]/) }
      NR > p && keep    { print }
    ' "$out" || true
  fi
fi
if [[ -n "$verdict" ]]; then echo; echo "$verdict"; fi
exit "$code"
